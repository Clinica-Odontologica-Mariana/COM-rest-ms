POSTGRES_DB=postgres-db
POSTGRES_USER=postgres-usuarios
POSTGRES_PASSWORD=postgres-senha

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/postgres-db
SPRING_DATASOURCE_USERNAME=postgres-usuarios
SPRING_DATASOURCE_PASSWORD=postgres-senha
SPRING_DATASOURCE_DOCKER_URL=jdbc:postgresql://postgres:5432/postgres-db
SPRING_DATASOURCE_DOCKER_USERNAME=postgres-usuarios
SPRING_DATASOURCE_DOCKER_PASSWORD=postgres-senha
SPRING_JPA_HIBERNATE_DDL_AUTO=none

KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin

KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=rest-ms
KEYCLOAK_CLIENT_ID=rest-ms-api
KEYCLOAK_CLIENT_SECRET=rest-ms-api-secret
KEYCLOAK_ADMIN_USERNAME=api-admin
KEYCLOAK_ADMIN_PASSWORD=api-admin123

SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://keycloak:8080/realms/rest-ms
# Optional alias for future environments/tools that use generic naming.
KEYCLOAK_ISSUER_URI=
KEYCLOAK_JWK_SET_URI=

SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false

GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REFRESH_TOKEN=seu-refresh-token
GOOGLE_CALENDAR_ID=primary

MINIO_ENDPOINT=http://minio:9000
MINIO_DOCKER_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=com-rest-ms
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_EXPIRATION_SECONDS=300
MINIO_CREATE_BUCKET_IF_MISSING=true

APP_FILES_PROFILE_PHOTO_MAX_SIZE_BYTES=5242880
APP_FILES_PROFILE_PHOTO_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
APP_FILES_ODONTOGRAM_MAX_SIZE_BYTES=10485760
APP_FILES_ODONTOGRAM_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

SERVER_PORT=8080
